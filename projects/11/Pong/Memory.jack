/**
 * This library provides two services: direct access to the computer's main
 * memory (RAM), and allocation and recycling of memory blocks. The Hack RAM
 * consists of 32,768 words, each holding a 16-bit binary number.
 */ 
class Memory {
    static Array memory;
    static int free;
    static int last_free;

    /** Initializes the class. */
    function void init() {
        let memory = 0;
        let free = 2048;
        let last_free = 2048;
        let memory[free] = 14336;
        let memory[free + 1] = 0;
        return;
    }

    /** Returns the RAM value at the given address. */
    function int peek(int address) {
        return memory[address];
    }

    /** Sets the RAM value at the given address to the given value. */
    function void poke(int address, int value) {
        let memory[address] = value;
        return;
    }

    /** Finds an available RAM block of the given size and returns
     *  a reference to its base address. */
    function int alloc(int size) {
        var int block, free_size, free_addr;
        if (~(size > 0)) {
            return 0;
        }

        let size = size + 1;

        let free_addr = free;
        let free_size = memory[free];

        while ((free_size < (size + 2)) & (free_addr > 0)) {
            let free_addr = memory[free_addr + 1];
            let free_size = memory[free_addr];
        }

        if (free_addr > 0) {
            let memory[free_addr] = memory[free_addr] - size;
            let block = free_addr + free_size - size;
            let memory[block] = size;
            let block = block + 1;
            return block;
        } else {
            do Sys.error(1);
            return -1;
        }
    }


    /** De-allocates the given object (cast as an array) by making
     *  it available for future allocations. */
    function void deAlloc(Array o) {
        var int free_size, free_addr, free_end, free_next, re_addr, re_size, linked_addr, linked_size, linked_next;
        let linked_addr = 0;
        let re_addr = o - 1;
        let re_size = memory[re_addr];

        let free_addr = free;
        let free_size = memory[free];
        let free_end = free_addr + free_size;
        let free_next = memory[free + 1];

        while ((free_addr > 0) & (linked_addr = 0)) {

            // The free block is adjacent to the reclaimed block.
            if (free_end = re_addr) {
                let linked_size = free_size + re_size;
                let memory[free_addr] = linked_size;
                let linked_addr = free_addr;
            } else {
                // The free block is not adjacent to the reclaimed block, link the reclaimed block to the free block.
                if ((free_end < re_addr) & ((re_addr <  free_next) | (free_next = 0))) {
                    let memory[re_addr + 1] = memory[free_addr + 1]; 
                    let memory[free_addr + 1] = re_addr; 
                    let linked_addr = re_addr;
                    let linked_size = re_size;
                } else {
                    let free_addr = memory[free_addr + 1];
                    let free_size = memory[free_addr];
                    let free_end = free_addr + free_size;
                    let free_next = memory[free_addr + 1];
                }
            }
        }

        if (linked_addr = 0) {
            do Sys.error(1);
            do Sys.halt();
            return;
        } else {
            // Check if the reclaimed or merged free block is adjacent to the next block.
            let linked_next = memory[linked_addr + 1];
            if ((linked_addr + linked_size) = linked_next) {
                let memory[linked_addr] = linked_size + memory[linked_next];
                let memory[linked_addr + 1] = memory[linked_next + 1];
            }
        }

        return;
    }
}
