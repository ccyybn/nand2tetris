// File name: projects/12/Screen.jack
/**
 * A library of functions for displaying graphics on the screen.
 * The Hack physical screen consists of 512 rows (indexed 0..511, top to bottom)
 * of 256 pixels each (indexed 0..255, left to right). The top left pixel on 
 * the screen is indexed (0,0).
 */
class Screen {
    static boolean color;
    static Array mask;

    /** Initializes the Screen. */
    function void init() {
        var int i, val;
        let color = true;
        let mask = Array.new(16);

        let i = 0;
        let val = 1;
        while (i < 16) {
            let mask[i] = val;
            let val = val + val;
            let i = i + 1;
        }
        return;
    }

    /** Erases the entire screen. */
    function void clearScreen() {
        var int addr;
        let addr = 16384;
        while (addr < 24576) {
            do Memory.poke(addr, 0);
            let addr = addr + 1;
        }
        return;
    }

    /** Sets the current color, to be used for all subsequent drawXXX commands.
     *  Black is represented by true, white by false. */
    function void setColor(boolean b) {
        let color = b;
        return;
    }


    /** Draws the (x,y) pixel, using the current color. */
    function void drawPixel(int x, int y) {
        var int addr, bit, val, temp;

        let temp = x / 16;
        let addr = 16384 + (y * 32) + temp;
        let bit = x - (temp * 16);
        let val = Memory.peek(addr);

        if (color) {
            do Memory.poke(addr, mask[bit] | Memory.peek(addr));
        } else {
            do Memory.poke(addr, ~(mask[bit]) & Memory.peek(addr));
        }
        return;
    }

    /** Draws a line from pixel (x1,y1) to pixel (x2,y2), using the current color. */
    function void drawLine(int x1, int y1, int x2, int y2) {
        var int a, b, dx, dy, diff;
        var boolean is_up;

        if (y1 = y2) {
           do Screen.drawHorizontalLine(x1, x2, y1);
           return;
        }

        let diff = 0;
        let dx = Math.abs(x2 - x1);
        let dy = Math.abs(y2 - y1);

        // Swaps the two points
        if (x1 > x2) {
            let a = x1;
            let b = y1;
            let x1 = x2;
            let y1 = y2;
            let x2 = a;
            let y2 = b;
        }

        if (y2 > y1) {
            let is_up = true;
        } else {
            let is_up = false;
        }

        let a = 0;
        let b = 0;

        while ((~(a > dx)) & (~(b > dy))) {
            if (is_up) {
                do Screen.drawPixel(x1 + a, y1 + b);
            } else {
                do Screen.drawPixel(x1 + a, y1 - b);
            }
            if ((diff < 0) | (dy = 0)) {
                let a = a + 1;
                let diff = diff + dy;
            } else {
                let b = b + 1;
                let diff = diff - dx;
            }
        }
        return;
    }

    function void drawHorizontalLine(int x1, int x2, int y) {
        var int addr1, addr2, bit1, bit2, temp;
        var int addr, bit;

        if (x1 > x2) {
            let temp = x1;
            let x1 = x2;
            let x2 = temp;
        }

        let temp = x1 / 16;
        let addr1 = 16384 + (y * 32) + temp;
        let bit1 = x1 - (temp * 16);

        let temp = x2 / 16;
        let addr2 = 16384 + (y * 32) + temp;
        let bit2 = x2 - (temp * 16);

        let addr = addr1;
        let bit = bit1;

        while (~(addr > addr2)) {
            if (addr = addr2) {
                // The bit of the last address is aligned.
                if ((bit = 0) & (bit2 = 15)) {
                    do Memory.poke(addr, color);
                    let addr = addr + 1;
                } else {
                    // The bit of the last address is not aligned.
                    if (color) {
                        do Memory.poke(addr, mask[bit] | Memory.peek(addr));
                    } else {
                        do Memory.poke(addr, ~(mask[bit]) & Memory.peek(addr));
                    }
                    if (bit < bit2) {
                        let bit = bit + 1;
                    } else {
                        let bit = 0;
                        let addr = addr + 1;
                    }
                }
            } else {
                //The bit of the first address is aligned or the address is in the middle
                if (bit = 0) {
                    do Memory.poke(addr, color);
                    let addr = addr + 1;
                } else {
                    // The bit of the first address is not aligned.
                    if (color) {
                        do Memory.poke(addr, mask[bit] | Memory.peek(addr));
                    } else {
                        do Memory.poke(addr, ~(mask[bit]) & Memory.peek(addr));
                    }
                    if (bit < 15) {
                        let bit = bit + 1;
                    } else {
                        // Process the next address;
                        let bit = 0;
                        let addr = addr + 1;
                    }
                }
            }
        }
        return;
    }

    /** Draws a filled rectangle whose top left corner is (x1, y1)
     *  and bottom right corner is (x2,y2), using the current color. */
    function void drawRectangle(int x1, int y1, int x2, int y2) {
        var int y, end;
        let y = Math.min(y1, y2);
        let end = Math.max(y1, y2);
        while (~(y > end)) {
            do Screen.drawLine(x1, y, x2, y);
            let y = y + 1;
        }
        return;
    }

    /** Draws a filled circle of radius r<=181 around (x,y), using the current color. */
    function void drawCircle(int x, int y, int r) {
        var int dy, chord;
        let dy = -r;
        while (~(dy > r)) {
            let chord = Math.sqrt((r * r) - (dy * dy));
            do Screen.drawLine(x - chord, y + dy, x + chord, y + dy);
            let dy = dy + 1;
        }
        return;
    }
}
